#!/usr/bin/env bash
# Test double for curl. Records every invocation to $CURL_LOG (one line of
# arguments per call) and answers from fixture files, so tests can assert on
# the requests the auditor makes without any network access.
#
#   CURL_LOG          file to append invocations to (required)
#   STUB_HEADERS      file served for a HEAD request and, unless overridden,
#                     written to the -D file of a page GET
#   STUB_HEAD_HEADERS overrides STUB_HEADERS for HEAD only
#   STUB_GET_HEADERS  overrides STUB_HEADERS for the page GET only. May hold
#                     several response blocks, as curl -D writes for -L
#   STUB_HTML         file served for body requests
#   STUB_FINAL_URL    %{url_effective} of the page GET (default: the request)
#   STUB_REDIRECTS    %{num_redirects} of the page GET (default 0)
#   STUB_GET_STATUS   %{http_code} of the page GET (default 200)
#   STUB_GET_RC       exit code of the page GET (default 0), e.g. 63 for
#                     --max-filesize, 47 for --max-redirs, 28 for --max-time
#   STUB_PATH_STATUS  status for path probes with no STUB_PATHS entry (default 404)
#   STUB_PATHS        file of `path:status[:body-file[:content-type[:large]]]` lines that
#                     answers path probes. The line keyed `@baseline` answers the
#                     random missing-path probe. `@PATH@` in a body file is
#                     replaced with the requested path, to model a soft-404 page
#                     that echoes the URL. A fifth field `large` makes the stub
#                     exit 63, as curl does at --max-filesize.
#   STUB_MAP          directory of per-host overrides: <host>.headers and
#                     <host>.html win over STUB_HEADERS / STUB_HTML. Lets one
#                     run serve a different site per URL.
set -uo pipefail

printf '%s\n' "$*" >> "${CURL_LOG:?CURL_LOG must be set}"

args="$*"

# Options the auditor passes that change what the stub must produce.
url="" outfile="" hdrfile="" wfmt=""
argv=("$@")
for ((i = 0; i < ${#argv[@]}; i++)); do
    case "${argv[i]}" in
        -o) outfile="${argv[i+1]:-}" ;;
        -D) hdrfile="${argv[i+1]:-}" ;;
        -w) wfmt="${argv[i+1]:-}" ;;
        http://*|https://*) url="${argv[i]}" ;;
    esac
done

# Host of the requested URL, for the per-host override lookup.
host=""
if [[ -n "$url" ]]; then
    host="${url#*://}"
    host="${host%%/*}"
    host="${host%%\?*}"
fi

pick() { # $1 = suffix, $2 = fallback file
    if [[ -n "${STUB_MAP:-}" && -n "$host" && -f "${STUB_MAP}/${host}.$1" ]]; then
        printf '%s' "${STUB_MAP}/${host}.$1"
    else
        printf '%s' "${2:-}"
    fi
}

# A path probe carries the cache-busting query; nothing else does.
if [[ "$url" == *"?audit_cb="* ]]; then
    req="${url#*://}"
    req="${req#*/}"
    req="${req%%\?*}"
    key="$req"
    [[ "$req" == audit-missing-* ]] && key="@baseline"

    status="${STUB_PATH_STATUS:-404}" bodyfile="" ctype="" large=""
    if [[ -n "${STUB_PATHS:-}" && -f "${STUB_PATHS}" ]]; then
        status="404"
        while IFS=: read -r p s b c l; do
            [[ -z "$p" || "$p" == \#* ]] && continue
            if [[ "$p" == "$key" ]]; then
                status="$s" bodyfile="$b" ctype="$c" large="$l"
                break
            fi
        done < "$STUB_PATHS"
    fi

    if [[ -n "$hdrfile" ]]; then
        printf 'HTTP/1.1 %s\r\nContent-Type: %s\r\n\r\n' "$status" "$ctype" > "$hdrfile"
    fi
    if [[ -n "$outfile" ]]; then
        if [[ -n "$bodyfile" && -f "$bodyfile" ]]; then
            body=$(cat "$bodyfile")
            printf '%s\n' "${body//@PATH@/$req}" > "$outfile"
        else
            : > "$outfile"
        fi
    fi
    out="${wfmt//%\{http_code\}/$status}"
    printf '%s' "$out"
    [[ "$large" == "large" ]] && exit 63
    exit 0
fi

if [[ "$args" == *"-sI"* ]]; then
    f=$(pick headers "${STUB_HEAD_HEADERS:-${STUB_HEADERS:-}}")
    [[ -n "$f" && -f "$f" ]] && cat "$f"
elif [[ -n "$hdrfile" ]]; then
    # Page GET: headers to the -D file, body to the -o file, -w on stdout.
    f=$(pick headers "${STUB_GET_HEADERS:-${STUB_HEADERS:-}}")
    : > "$hdrfile"
    [[ -n "$f" && -f "$f" ]] && cat "$f" > "$hdrfile"
    f=$(pick html "${STUB_HTML:-}")
    : > "$outfile"
    [[ -n "$f" && -f "$f" ]] && cat "$f" > "$outfile"
    out="${wfmt//%\{url_effective\}/${STUB_FINAL_URL:-$url}}"
    out="${out//%\{num_redirects\}/${STUB_REDIRECTS:-0}}"
    out="${out//%\{http_code\}/${STUB_GET_STATUS:-200}}"
    printf '%s' "$out"
    exit "${STUB_GET_RC:-0}"
else
    f=$(pick html "${STUB_HTML:-}")
    [[ -n "$f" && -f "$f" ]] && cat "$f"
fi

exit 0
